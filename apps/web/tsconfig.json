{
	"compilerOptions": {
		"target": "esnext",
		"module": "preserve",
		"moduleDetection": "force",
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"types": ["bun"],
		"moduleResolution": "bundler",
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true
	}
}
